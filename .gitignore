# Ignore all contents in raw & processed data except .gitkeep and metadata
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/normalization.json
!data/processed/preprocessing_report.json
!data/processed/sample_metadata.csv
